---
import { languages } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import 'flag-icons/css/flag-icons.min.css';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const currentPath = Astro.url.pathname;

// Map language codes to country codes for flags
const flagCodes: Record<string, string> = {
  bs: 'ba', // Bosnia and Herzegovina
  en: 'gb', // United Kingdom
};
---

<div class="language-switcher">
  {Object.entries(languages).map(([langCode, name]) => {
    const isActive = lang === langCode;
    const href = translatePath(currentPath, langCode);
    
    return (
      <a 
        href={href}
        class={`lang-link ${isActive ? 'active' : ''}`}
        aria-current={isActive ? 'page' : undefined}
      >
        <span class={`fi fi-${flagCodes[langCode]} flag-icon`}></span>
        <span class="lang-name">{name}</span>
      </a>
    );
  })}
</div>

<style>
  .language-switcher {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  
  .lang-link {
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    color: #374151;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
    border: 1px solid transparent;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  
  .flag-icon {
    font-size: 1.25rem;
    line-height: 1;
    margin-right: 0.25rem;
  }
  
  .lang-name {
    white-space: nowrap;
  }
  
  .lang-link:hover {
    background-color: #f3f4f6;
    color: #1f2937;
  }
  
  .lang-link.active {
    background-color: #f59e0b;
    color: white;
    border-color: #d97706;
  }
  
  @media (max-width: 640px) {
    .language-switcher {
      gap: 0.25rem;
    }
    
    .lang-link {
      padding: 0.375rem 0.5rem;
      font-size: 0.75rem;
    }
    
    .flag-icon {
      font-size: 1rem;
    }
  }
</style>
