---
import PageLayout from "../../layouts/PageLayout.astro";
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { TESTIMONIALS_ENABLED, testimonials } from "../../config/testimonials";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<PageLayout>
  <main class="flex flex-col justify-center w-[90%] lg:w-[85%] mx-auto mt-24">
      
      <!-- Hero Section -->
      <section class="about-hero mb-12">
        <h1 class="md:px-2 max-md:mx-2 rounded font-exo2 uppercase text-3xl sm:text-4xl md:text-5xl font-bold mb-4">
          About Us
        </h1>
        <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-56 mb-6" />
        <p class="md:px-2 max-md:mx-2 text-lg mb-8">
          Welcome to Smetovi - the mountain that connects nature, tradition and community
        </p>
      </section>

      <!-- Content Sections -->
      <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Left Column -->
        <section class="about-content w-full lg:w-1/2">
          <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-2xl sm:text-3xl font-bold mb-4">
            Our Mission
          </h2>
          <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-40 mb-4" />
          <p class="m-2 mb-6">
            Smetovi represents an oasis of nature in the heart of Bosnia and Herzegovina. Our mission is 
            preserving natural heritage, promoting sustainable tourism and connecting people with 
            nature through hiking and recreational activities.
          </p>

          <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-2xl sm:text-3xl font-bold mb-4 mt-8">
            Our History
          </h2>
          <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-40 mb-4" />
          <p class="m-2 mb-6">
            Mount Smetovi has been home to the local community for centuries, preserving rich traditions 
            and natural beauty. Today we continue to nurture this heritage through organized 
            activities and nature conservation programs.
          </p>
        </section>

        <!-- Right Column -->
        <section class="about-content w-full lg:w-1/2">
          
          <!-- Adding the missing "What We Offer" section -->
          <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-2xl sm:text-3xl font-bold mb-4">
            What We Offer
          </h2>
          <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-40 mb-4" />
          <div class="m-2 mb-6">
            <div class="mb-3 flex gap-3">
              <span><i class="fa-solid fa-mountain text-darkBlue"></i></span>
              <span>Hiking and walking trails</span>
            </div>
            <div class="mb-3 flex gap-3">
              <span><i class="fa-solid fa-camera text-darkBlue"></i></span>
              <span>Nature photography</span>
            </div>
            <div class="mb-3 flex gap-3">
              <span><i class="fa-solid fa-users text-darkBlue"></i></span>
              <span>Group activities and events</span>
            </div>
            <div class="mb-3 flex gap-3">
              <span><i class="fa-solid fa-leaf text-darkBlue"></i></span>
              <span>Nature education</span>
            </div>
          </div>

          <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-2xl sm:text-3xl font-bold mb-4 mt-8">
            Join Us
          </h2>
          <hr class="md:px-2 mx-2 bg-yellow border-0 h-1 w-40 mb-4" />
          <p class="m-2 mb-4">
            Become part of our community of nature lovers! Follow our activities, 
            join our events and discover the charms of Mount Smetovi.
          </p>
          <div class="m-2">
            <a href="/en/contact">
              <button>
                <div class="diagonal-border px-4 py-3 bg-darkBlue text-white">
                  Contact us
                </div>
              </button>
            </a>
          </div>
        </section>
      </div>

      <!-- Testimonials Section -->
      {TESTIMONIALS_ENABLED && (
      <section class="testimonials-section mt-16 mb-12">
        <h2 class="md:px-2 max-md:mx-2 font-exo2 uppercase text-3xl sm:text-4xl font-bold mb-4 text-center">
          What our visitors say
        </h2>
        <hr class="bg-yellow border-0 h-1 w-56 mb-12 mx-auto" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          {testimonials.map((testimonial) => (
          <div class="testimonial-card bg-white p-6 rounded-lg shadow-lg border-l-4 border-yellow">
            <div class="flex items-center mb-4">
              <div class="testimonial-avatar bg-darkBlue text-white rounded-full w-12 h-12 flex items-center justify-center mr-3">
                <i class="fa-solid fa-user"></i>
              </div>
              <div>
                <h4 class="font-bold text-darkBlue">{testimonial.name}</h4>
                <p class="text-sm text-gray-600">{testimonial.location.en}</p>
              </div>
            </div>
            <div class="flex mb-3">
              {Array.from({ length: 5 }).map((_, index) => (
                <i class={`fa-solid fa-star ${index < testimonial.rating ? 'text-yellow' : 'text-gray-300'}`}></i>
              ))}
            </div>
            <p class="text-gray-700 italic">
              "{testimonial.text.en}"
            </p>
          </div>
          ))}

        </div>

        <!-- Call to Action for Reviews -->
        <div class="text-center mt-12">
          <h3 class="font-exo2 uppercase text-xl font-bold mb-4 text-darkBlue">
            Share your experience
          </h3>
          <p class="mb-6 text-gray-700">
            Have you visited Smetovi? Share your experience with others!
          </p>
          <a href="/en/contact">
            <button>
              <div class="diagonal-border px-6 py-3 bg-darkBlue text-white">
                Leave a review
              </div>
            </button>
          </a>
        </div>
      </section>
      )}

  </main>

  <svg width="0" height="0" class="hidden">
    <defs>
      <mask id="diagonal-mask" maskUnits="objectBoundingBox">
        <polygon fill="white" points="
          0,0         <!-- top-left -->
          0.9,0       <!-- almost top-right -->
          1,0.1       <!-- diagonal top-right -->
          1,1         <!-- bottom-right -->
          0.1,1       <!-- almost bottom-left -->
          0,0.9       <!-- diagonal bottom-left -->
        " />
      </mask>
    </defs>
  </svg>
</PageLayout>
